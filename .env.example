# ─────────────────────────────────────────────────────────────
# Orbit 环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# ⚠️ .env 已在 .gitignore 中，切勿提交真实密钥
# ─────────────────────────────────────────────────────────────

# ── 运行环境 ──
# development | production
ENV=development

# ── LLM 配置（必填）──
# 服务启动时会校验 LLM_API_KEY，缺失将拒绝启动
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# ── LLM 可靠性（可选，有默认值）──
# 主模型不可用时自动降级到备用模型
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_API_KEY=
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=30.0
# 熔断器：连续失败 N 次后熔断 M 秒
LLM_CB_FAIL_MAX=5
LLM_CB_TIMEOUT=60

# ── 认证（必填）──
# 至少 32 字符随机串，生成方式：python3 -c "import secrets; print(secrets.token_hex(32))"
# 缺失或过短将拒绝启动；变更后所有已签发 Token 立即失效
SECRET_KEY=

# ── CORS（必填，不可用 * ）──
# 多个来源用逗号分隔
CORS_ORIGINS=http://localhost:3000

# ── 数据库 ──
DATABASE_URL=sqlite:///./multitenant.db

# ── Embedding ──
# sentence-transformers | ollama | openai
EMBED_BACKEND=sentence-transformers
EMBED_MODEL=all-MiniLM-L6-v2
OLLAMA_HOST=http://localhost:11434
# 模型下载源：国内直连 huggingface.co 不可达（会超时），Docker 部署默认走镜像站；
# 海外环境可改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ── Knowledge Agent ──
KNOWLEDGE_AGENT_TIMEOUT_SECONDS=20
# 每日 token 预算（用于用量面板告警，达 80% 触发提示）
LLM_DAILY_LIMIT_TOKENS=1000000

# ── 可观测性（可选）──
# 启用 Prometheus /metrics 端点，需先安装 prometheus-fastapi-instrumentator
ENABLE_PROMETHEUS=
# Sentry 错误追踪，需先安装 sentry-sdk
SENTRY_DSN=

# ── 前端（frontend/.env.local）──
# NEXT_PUBLIC_API_URL=http://localhost:8001
