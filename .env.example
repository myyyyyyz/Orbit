# ─────────────────────────────────────────────────────────────
# Orbit 环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# ⚠️ .env 已在 .gitignore 中，切勿提交真实密钥
# ─────────────────────────────────────────────────────────────

# ── 运行环境 ──
# development | production
ENV=development

# ── LLM 配置（必填）──
# 服务启动时会校验 LLM_API_KEY，缺失将拒绝启动
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# ── LLM 可靠性（可选，有默认值）──
# 主模型不可用时自动降级到备用模型。
# ⚠️ 备用模型必须配**对应厂商**的 LLM_FALLBACK_BASE_URL + LLM_FALLBACK_API_KEY，
#    否则请求会被发到主模型端点而必定失败。留空 = 不启用降级。
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=30.0
# 熔断器：连续失败 N 次后熔断 M 秒
LLM_CB_FAIL_MAX=5
LLM_CB_TIMEOUT=60

# ── 路由分档模型（可选）──
# 路由会按问题复杂度分 fast / balanced / strong 三档。不配置时**三档都等于
# 上面的 LLM_MODEL**（单一厂商部署的实际情况）；留空即走这个默认值。
# ⚠️ 若填写，必须是 LLM_BASE_URL 对应厂商的模型名，否则必定 400。
LLM_MODEL_FAST=
LLM_MODEL_BALANCED=
LLM_MODEL_STRONG=
# 命中 PII 时锁定的模型（默认与 LLM_MODEL 相同）
LLM_MODEL_LOCAL=
# PDF 内嵌图的视觉提取模型（默认与 LLM_MODEL 相同；须支持 image_url 输入）
LLM_MODEL_VISION=

# ── 认证（必填）──
# 至少 32 字符随机串，生成方式：python3 -c "import secrets; print(secrets.token_hex(32))"
# 缺失或过短将拒绝启动；变更后所有已签发 Token 立即失效
SECRET_KEY=

# ── CORS（必填，不可用 * ）──
# 多个来源用逗号分隔
CORS_ORIGINS=http://localhost:3000

# ── 数据库 ──
DATABASE_URL=sqlite:///./multitenant.db

# ── Embedding ──
# 单一实现，**不可配置后端**：使用 chromadb 自带的 ONNX Runtime 版
# all-MiniLM-L6-v2（384 维），模型首次运行自动下载到 <DATA_DIR>/.cache（约 80MB，
# 来源为 chroma-onnx-models S3，不走 HuggingFace）。
# 更换 embedding 模型会改变向量维度、必须重建整个向量库，属于发版动作而非配置项；
# 需要时请改 app/config.py 的 EmbedStrategy 并同步重建索引。

# ── Knowledge Agent ──
KNOWLEDGE_AGENT_TIMEOUT_SECONDS=20
# 每日 token 预算（用于用量面板告警，达 80% 触发提示）
LLM_DAILY_LIMIT_TOKENS=1000000

# ── 可观测性（可选）──
# 启用 Prometheus /metrics 端点，需先安装 prometheus-fastapi-instrumentator
ENABLE_PROMETHEUS=
# Sentry 错误追踪，需先安装 sentry-sdk
SENTRY_DSN=

# ── 前端（frontend/.env.local）──
# NEXT_PUBLIC_API_URL=http://localhost:8001
